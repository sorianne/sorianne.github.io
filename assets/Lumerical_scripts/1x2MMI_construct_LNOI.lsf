## width optimization
start_W_MMI = 4.7e-6;
stop_W_MMI = 5.5e-6;
step_W_MMI = 0.1e-6;
iterator = (stop_W_MMI-start_W_MMI)/step_W_MMI;
W_MMI_list = linspace(start_W_MMI,stop_W_MMI,iterator + 1);

result1 = zeros(1, iterator + 1); 

switchtolayout;

for(i=1;i<=iterator+1;i=i+1)
{
?i;
switchtolayout;

W_MMI = W_MMI_list(i);
select("MMI_rec");
set("base width",W_MMI);

select("FDTD");
set("y span",W_MMI+xx_width);

select("mon_whole");
set("y span",W_MMI+xx_width);

select("ex_output_up"); 
set("y max",(W_MMI+xx_width)/2);

select("mon_output_up");
set("y max",(W_MMI+xx_width)/2);

select("ex_output_down"); 
set("y min",-(W_MMI+xx_width)/2);

select("mon_output_down");
set("y min",-(W_MMI+xx_width)/2);

run;

T_result = getresult("ex_output_up", "expansion for input.T_net");
T_net1 = abs(T_result.T_net);
result1(1,i) = T_net1;
}

#T_max = max(T_net1);
#idx = find(T_net1 == T_max);
#L_best = L_MMI(idx);

#?("Best T = " + num2str(T_max) + " at L = " + num2str(L_best*1e6) + " um");
filename=num2str(L_MMI*1e9)+"nm_LNOI_W_sweep"; # set filename
matlabsave(filename,W_MMI_list,result1); 

